{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeldiffr.dev/schema/causal-1.json",
  "title": "Modeldiffr causal file",
  "type": "object",
  "required": [
    "schema",
    "id",
    "created_at",
    "modeldiffr_version",
    "manifest",
    "result_sha256",
    "behavior",
    "conditions",
    "top_features"
  ],
  "properties": {
    "schema": {
      "const": "modeldiffr.causal/1"
    },
    "id": {
      "type": "string",
      "pattern": "^mdrc1:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string"
    },
    "modeldiffr_version": {
      "type": "string"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema",
        "base",
        "derivative",
        "code",
        "layer",
        "suite",
        "crosscoder",
        "features_id",
        "settings"
      ],
      "properties": {
        "base": {
          "type": "object",
          "required": [
            "model_id",
            "weights_root"
          ],
          "properties": {
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "weights_root": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "weights_algorithm": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokenizer_vocab": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokenizer_json": {
              "type": [
                "string",
                "null"
              ]
            },
            "chat_template": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "derivative": {
          "type": "object",
          "required": [
            "model_id",
            "weights_root"
          ],
          "properties": {
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "weights_root": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "weights_algorithm": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokenizer_vocab": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokenizer_json": {
              "type": [
                "string",
                "null"
              ]
            },
            "chat_template": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "code": {
          "type": "object",
          "required": [
            "package",
            "version"
          ]
        },
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "suite": {
          "type": "object",
          "required": [
            "name",
            "root",
            "items"
          ],
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "crosscoder": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "features_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^mdrf1:[0-9a-f]{64}$"
            }
          ]
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "audit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "audit_id",
            "changed"
          ],
          "properties": {
            "audit_id": {
              "type": "string",
              "pattern": "^mdr1:[0-9a-f]{64}$"
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "required": [
        "metric",
        "base",
        "derivative"
      ]
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "items",
          "behavior_delta",
          "behavior_ci",
          "moved",
          "share",
          "share_ci",
          "explainable"
        ],
        "properties": {
          "share": {
            "type": [
              "number",
              "null"
            ]
          },
          "share_ci": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "explainable": {
            "type": "boolean"
          }
        }
      }
    },
    "top_features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "attribution",
          "class"
        ]
      }
    }
  }
}
